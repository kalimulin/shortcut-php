# Приложение
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

# Публичный URL сайта (без завершающего слэша)
APP_URL=https://example.com
SHORTCUT_BASE_HOST=example.com
SHORTCUT_BASE_SCHEME=https
SHORTCUT_REDIRECT_PREFIX=s

# База данных MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shortcut_db
DB_USER=shortcut_user
DB_PASS=change_me
DB_CHARSET=utf8mb4

# JWT авторизация (обязательно смените JWT_SECRET на случайную строку >= 32 символов!)
JWT_SECRET=change-this-to-a-long-random-secret-string-at-least-32-chars
JWT_TTL_SECONDS=604800

# Настройки коротких ссылок
SHORTCUT_MAX_URL_LENGTH=2048
SHORTCUT_CREATE_MAX_ATTEMPTS=5
PUBLIC_SHORTCUT_TTL_HOURS=48

# Проверка URL (домены через запятую)
URL_CHECK_SUSPICIOUS_DOMAINS=bit.ly,tinyurl.com,goo.gl,ow.ly,is.gd,buff.ly,cutt.ly,clck.ru,t.ly,rebrand.ly,shorturl.at,v.gd

# Статистика и часовой пояс отчётов (по умолчанию +03:00 Москва)
REPORT_TIMEZONE=+03:00
CLICK_STATS_DEFAULT_DAYS=30

# Rate limit (запросов в минуту на IP)
RATE_LIMIT_PUBLIC_SHORTCUT_PER_MIN=20
RATE_LIMIT_LOGIN_PER_MIN=15

# CORS (оставьте пустым при одном домене; для локальной разработки фронта укажите http://localhost:5173)
CORS_ALLOWED_ORIGIN=

# Верификация email и защита от ботов
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFY_DNS_CHECK=false

# Отправка email (mail — через функцию mail() хостинга, smtp — через внешний SMTP)
MAIL_DRIVER=mail
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_SUPPORT_ADDRESS=support@example.com
MAIL_FROM_NAME=Омни Ссылки

# Настройки SMTP (заполняются при MAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=ssl

